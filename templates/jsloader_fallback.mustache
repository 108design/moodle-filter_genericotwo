{{!
    Fallback JS delivery for content that can't rely on this request's own page lifecycle
    (or the Fragment API) to flush js_amd_inline() to the client - e.g. external webservice/
    mobile app responses, or content rendered after this page's own footer has already been
    sent. The JS travels embedded in the HTML itself and self-executes via the
    filter_genericotwo/loader AMD module's ready/queue trampoline. See jsloader.mustache for
    the default path, used whenever this page's own footer (or the Fragment API) can still
    deliver the JS via js_amd_inline().
}}
<script>
    (function() {
        if (typeof window.filter_genericotwo === 'undefined') {
            window.filter_genericotwo = {
                queue: [],
                ready: false,
                run: function(cb) {
                    if (this.ready) {
                        cb();
                    } else {
                        this.queue.push(cb);
                    }
                }
            };
        }

        window.filter_genericotwo.run(function() {
            {{{jscontent}}}
        });
    })();
</script>
