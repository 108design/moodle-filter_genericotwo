<p>
    <a class="btn btn-primary" href="{{addtemplateurl}}">{{#str}}addtemplate, filter_genericotwo{{/str}}</a>
</p>

{{#haveupdates}}
<p>
    <a class="btn btn-secondary" href="{{updateallurl}}">{{#str}}updateall, filter_genericotwo{{/str}}</a>
</p>
{{/haveupdates}}

<table class="generaltable">
    <thead>
        <tr>
            <th class="header c0">{{#str}}template_name, filter_genericotwo{{/str}}</th>
            <th class="header c1">{{#str}}template_templatekey, filter_genericotwo{{/str}}</th>
            <th class="header c2">{{#str}}template_version, filter_genericotwo{{/str}}</th>
            <th class="header c3">{{#str}}actions, core{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#templates}}
        <tr>
            <td class="cell c0">{{name}}</td>
            <td class="cell c1">{{templatekey}}</td>
            <td class="cell c2">
                {{version}}
                {{#hasupdate}}
                    <a class="btn btn-secondary btn-sm ml-1" href="{{updateurl}}">{{updatelabel}}</a>
                {{/hasupdate}}
            </td>
            <td class="cell c3">
                <a href="{{editurl}}">{{#str}}edit, core{{/str}}</a>
                |
                <a href="{{deleteurl}}">{{#str}}delete, core{{/str}}</a>
            </td>
        </tr>
        {{/templates}}
    </tbody>
</table>
